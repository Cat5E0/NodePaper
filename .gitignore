# Build outputs. Anchored so internal/build/ (Go sources) stays tracked.
/build/
**/.nodepaper/
**/dist/

# Lock-state Fixture inputs are source test data, not generated artifacts.
!nodepaper-test-fixtures/tests/fixtures/damaged-lock/.nodepaper/
!nodepaper-test-fixtures/tests/fixtures/damaged-lock/.nodepaper/build.lock
!nodepaper-test-fixtures/tests/fixtures/stale-lock/.nodepaper/
!nodepaper-test-fixtures/tests/fixtures/stale-lock/.nodepaper/build.lock

# Logs
logs/

# LaTeX auxiliary files
*.aux
*.fls
*.fdb_latexmk
*.out
*.toc
*.synctex.gz
*.xdv
*.bbl
*.blg
*.run.xml

# Compiled outputs at project root
/Paper.pdf
/Paper.tex

# Local experiment screenshots are not repository assets.

# Bundled third-party binaries and pinned build toolchains (fetched, verified
# and never committed)
tools/windows-x64/
tools/_downloads/
!tools/versions.json

# Python
__pycache__/
*.pyc
*.pyo

# OS
Thumbs.db
.DS_Store

# Claude Code 本地权限配置（含本机绝对路径，不共享）
.claude/settings.local.json

# XeLaTeX 在仓库根目录留下的临时日志
texput.log
