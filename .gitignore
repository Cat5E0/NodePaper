# Per-project generated output.  These two directories coexist after a build:
# `.nodepaper/` is NodePaper's work state (intermediate TeX, logs and locks),
# while `dist/` is the user-facing final output.  Neither is project source.
# Anchored `/build/` keeps internal/build/ (Go sources) tracked.
/build/
**/.nodepaper/
**/dist/

# Lock-state Fixture inputs are source test data, not generated artifacts.
!nodepaper/core/tests/fixtures/damaged-lock/.nodepaper/
!nodepaper/core/tests/fixtures/damaged-lock/.nodepaper/build.lock
!nodepaper/core/tests/fixtures/stale-lock/.nodepaper/
!nodepaper/core/tests/fixtures/stale-lock/.nodepaper/build.lock

# Logs
/logs/
/cache/
/temp/
/tmp/

# LaTeX auxiliary files
*.aux
*.fls
*.fdb_latexmk
*.out
*.toc
*.synctex.gz
*.xdv
*.bbl
*.blg
*.run.xml
skills/
AGENTS.md
# Compiled outputs at project root
/Paper.pdf
/Paper.tex

# Local experiment screenshots are not repository assets.

# Bundled third-party binaries and pinned build toolchains (fetched, verified
# and never committed)
/tools/
# 桌面端内嵌的 nodepaper core 二进制（desktop-build/desktop CI 构建时生成）
/nodepaper/desktop/binaries/

# Python
__pycache__/
*.pyc
*.pyo

# OS
Thumbs.db
.DS_Store

# Claude Code 本地权限配置（含本机绝对路径，不共享）
.claude/settings.local.json

# XeLaTeX 在仓库根目录留下的临时日志
texput.log
